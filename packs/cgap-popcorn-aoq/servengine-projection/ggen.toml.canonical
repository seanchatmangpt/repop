[project]
name = "servengine-patch"
version = "1.0.0"
authors = ["repop wave v26.11.8 / lane G4"]
license = "Apache-2.0"

[ontology]
source = "packs/cgap-popcorn-aoq/servengine-projection/ontology/servengine-patch.ttl"
standard_only = false

[generation]
output_dir = "dist/servengine-patch"

[[generation.rules]]
name = "tsconfig-paths"
query = { file = "packs/cgap-popcorn-aoq/servengine-projection/queries/aliases.rq" }
template = { file = "packs/cgap-popcorn-aoq/servengine-projection/templates/tsconfig-paths.snippet.json.tera" }
output_file = "tsconfig-paths.snippet.json"
mode = "Overwrite"

[[generation.rules]]
