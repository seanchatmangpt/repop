# FAIL witness 020_offset_contiguity: MUTATION = w:f1 nextOffset 63 (chain
# broken: offset 2 + sizeBytes 62 != 63). Gate 020 must return >=1 row.
@prefix cp: <urn:cgap-popcorn-aoq:> .
@prefix w: <urn:cgap-popcorn-aoq:witness:fail/> .

w:frame a cp:WireFrame .

w:f0 a cp:FrameField ;
    cp:fieldOf w:frame ; cp:offset 0 ; cp:sizeBytes 2 ; cp:nextOffset 2 .

w:f1 a cp:FrameField ;
    cp:fieldOf w:frame ; cp:offset 2 ; cp:sizeBytes 62 ; cp:nextOffset 63 .
