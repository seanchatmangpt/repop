# Classes
cp:WireFrame a owl:Class ;
    rdfs:label "a pinned 64-byte wire frame across kernel/worker/client" .
cp:IntentFrame a owl:Class ;
    rdfs:subClassOf cp:WireFrame ;
    rdfs:label "IntentFrame - pinned 64B frame, layout_spec.rs table" .
cp:HyperplaneRegister a owl:Class ;
    rdfs:subClassOf cp:WireFrame ;
    rdfs:label "HyperplaneRegister - pinned 64B frame, layout_spec.rs table" .
cp:ReceiptFrame a owl:Class ;
