# cgap-popcorn-aoq ontology — single source of truth for the repop frontend surface.
# GENERATED by scripts/gen_ontology.py — do not hand-edit; regenerate instead.
# Standing: UNVERIFIED (ggen-marketplace admission deferred; offsets-vs-P1 reconciliation pending).
# Grounding: 64B FrameHeader; FNV-1a32 over bytes [0x00,0x3C) stored at offset 0x3C.

@prefix cp: <urn:cgap-popcorn-aoq:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# Classes
cp:FrameHeader a owl:Class ;
    rdfs:label "FrameHeader - the pinned 64-byte wire header across kernel/worker/client" .
cp:FrameField a owl:Class ;
    rdfs:label "one offset/width row of the 64B field table" ;
    rdfs:seeAlso <urn:cgap:crate:cgap-aoq:generated_aoq_header_layout.rs> .
cp:StatusConstant a owl:Class ;
    rdfs:label "named wire constants (magic, version, status band, algorithm IDs)" .
cp:SeamNote a owl:Class ;
    rdfs:label "a documented upgrade or transport seam in the wire surface" .
cp:Hyperplane a owl:Class ;
    rdfs:label "hyperplane solver input surface (planes, normals, bounds)" .

cp:FrameType a owl:Class ;
    owl:oneOf ( cp:ftIntent cp:ftHyperplane cp:ftReceipt ) ;
    rdfs:label "FrameType - closed enum" .
cp:ftIntent a cp:FrameType ; cp:value 1 .
cp:ftHyperplane a cp:FrameType ; cp:value 2 .
cp:ftReceipt a cp:FrameType ; cp:value 3 .

cp:StatusCode a owl:Class ;
    owl:oneOf ( cp:scA001 cp:scA002 cp:scA003 cp:scA004 cp:scA005 cp:scA006 cp:scA007 cp:scA008 cp:scA009 ) ;
    rdfs:label "StatusCode over band 0x5250A001..0x5250A009 - closed enum" .
cp:scA001 a cp:StatusCode ; cp:value 1381015553 .
cp:scA002 a cp:StatusCode ; cp:value 1381015554 .
cp:scA003 a cp:StatusCode ; cp:value 1381015555 .
cp:scA004 a cp:StatusCode ; cp:value 1381015556 .
cp:scA005 a cp:StatusCode ; cp:value 1381015557 .
cp:scA006 a cp:StatusCode ; cp:value 1381015558 .
cp:scA007 a cp:StatusCode ; cp:value 1381015559 .
cp:scA008 a cp:StatusCode ; cp:value 1381015560 .
cp:scA009 a cp:StatusCode ; cp:value 1381015561 .

cp:AgentTier a owl:Class ;
    owl:oneOf ( cp:atClient cp:atBoundary cp:atServer ) ;
    rdfs:label "AgentTier - closed enum" .
cp:atClient a cp:AgentTier ; cp:value 0 .
cp:atBoundary a cp:AgentTier ; cp:value 1 .
cp:atServer a cp:AgentTier ; cp:value 2 .

cp:HookName a owl:Class ;
    owl:oneOf ( cp:hnOnFrameDecode cp:hnOnReceiptSeal cp:hnOnBreach ) ;
    rdfs:label "HookName - closed enum" .
cp:hnOnFrameDecode a cp:HookName ; cp:value 1 .
cp:hnOnReceiptSeal a cp:HookName ; cp:value 2 .
cp:hnOnBreach a cp:HookName ; cp:value 3 .

cp:ActorMessageKind a owl:Class ;
    owl:oneOf ( cp:amDecode cp:amEncode cp:amSeal cp:amVerify cp:amRefuse ) ;
    rdfs:label "ActorMessageKind - closed enum" .
cp:amDecode a cp:ActorMessageKind ; cp:value 1 .
cp:amEncode a cp:ActorMessageKind ; cp:value 2 .
cp:amSeal a cp:ActorMessageKind ; cp:value 3 .
cp:amVerify a cp:ActorMessageKind ; cp:value 4 .
cp:amRefuse a cp:ActorMessageKind ; cp:value 5 .

cp:WireKind a owl:Class ;
    owl:oneOf ( cp:wkU8 cp:wkU16LE cp:wkU32LE cp:wkBytes32 cp:wkBytes8 cp:wkBytes4 ) ;
    rdfs:label "WireKind - closed enum of wire primitive shapes - closed enum" .
cp:wkU8 a cp:WireKind ; cp:value 0 .
cp:wkU16LE a cp:WireKind ; cp:value 1 .
cp:wkU32LE a cp:WireKind ; cp:value 2 .
cp:wkBytes32 a cp:WireKind ; cp:value 3 .
cp:wkBytes8 a cp:WireKind ; cp:value 4 .
cp:wkBytes4 a cp:WireKind ; cp:value 5 .

# Status band doc lines
# cp:scA001 = 0x5250A001 OK — success
# cp:scA002 = 0x5250A002 STALE_VERSION — layout version older than pinned 1
# cp:scA003 = 0x5250A003 BAD_MAGIC — frame magic mismatch
# cp:scA004 = 0x5250A004 UNSUPPORTED_ALG — unknown algId — typed refusal
# cp:scA005 = 0x5250A005 DIGEST_MISMATCH — FNV-1a32 verification failed
# cp:scA006 = 0x5250A006 CAS_CONFLICT — optimistic concurrency version conflict
# cp:scA007 = 0x5250A007 BREACH — hyperplane breach
# cp:scA008 = 0x5250A008 DRIFT — entity drift detected
# cp:scA009 = 0x5250A009 SEAL_REQUIRED — receipt requires server-side seal

# Properties
cp:offset a owl:DatatypeProperty ; rdfs:range xsd:unsignedInt .
cp:sizeBytes a owl:DatatypeProperty ; rdfs:range xsd:unsignedInt .
cp:nextOffset a owl:DatatypeProperty ; rdfs:range xsd:unsignedInt .
cp:value a owl:DatatypeProperty ; rdfs:range xsd:integer .
cp:cName a owl:DatatypeProperty ; rdfs:range xsd:string .
cp:rustName a owl:DatatypeProperty ; rdfs:range xsd:string .
cp:tsName a owl:DatatypeProperty ; rdfs:range xsd:string .
cp:constantId a owl:DatatypeProperty ; rdfs:range xsd:string .
cp:algorithmId a owl:DatatypeProperty ; rdfs:range xsd:string .
cp:hookName a owl:DatatypeProperty ; rdfs:range xsd:string .
cp:tierId a owl:DatatypeProperty ; rdfs:range xsd:unsignedInt .
cp:planeDim a owl:DatatypeProperty ; rdfs:range xsd:unsignedInt .
cp:wireKind a owl:ObjectProperty ; rdfs:range cp:WireKind .
cp:fieldOf a owl:ObjectProperty ; rdfs:range cp:FrameHeader .
cp:planeNormal a owl:ObjectProperty ; rdfs:range cp:Hyperplane .
cp:docBand a owl:AnnotationProperty .
cp:seam a owl:AnnotationProperty .

# FrameHeader individual + field table (contiguity 0->64)
cp:hdr a cp:FrameHeader ;
    cp:constantId "CGAP-POPcorn-AOQ-HEADER" ;
    rdfs:label "64B FrameHeader - magic 0x52503031, version 1, FNV-1a32 over [0x00,0x3C) at 0x3C" ;
    prov:wasDerivedFrom <urn:cgap:crate:cgap-aoq:header.rs> ,
        <urn:cgap:crate:cgap-aoq:generated_aoq_header_layout.rs> ,
        <urn:cgap:crate:cgap-aoq:pin_table.rs> .

cp:f_magic a cp:FrameField ;
    cp:fieldOf cp:hdr ;
    cp:offset 0 ; cp:sizeBytes 4 ; cp:nextOffset 4 ;
    cp:wireKind cp:wkU32LE ;
    cp:cName "magic" ; cp:rustName "magic" ; cp:tsName "magic" ;
    cp:value 1380986929 ;
    rdfs:label "frame magic, pinned 0x52503031" .

cp:f_version a cp:FrameField ;
    cp:fieldOf cp:hdr ;
    cp:offset 4 ; cp:sizeBytes 2 ; cp:nextOffset 6 ;
    cp:wireKind cp:wkU16LE ;
    cp:cName "version" ; cp:rustName "version" ; cp:tsName "version" ;
    cp:value 1 ;
    rdfs:label "layout version, pinned 1" .

cp:f_algId a cp:FrameField ;
    cp:fieldOf cp:hdr ;
    cp:offset 6 ; cp:sizeBytes 2 ; cp:nextOffset 8 ;
    cp:wireKind cp:wkU16LE ;
    cp:cName "alg_id" ; cp:rustName "alg_id" ; cp:tsName "algId" ;
    rdfs:label "algId seam: 0x0000 keyed-BLAKE3 | 0x0001 ML-DSA-65; unknown = typed refusal" .

cp:f_status a cp:FrameField ;
    cp:fieldOf cp:hdr ;
    cp:offset 8 ; cp:sizeBytes 2 ; cp:nextOffset 10 ;
    cp:wireKind cp:wkU16LE ;
    cp:cName "status" ; cp:rustName "status" ; cp:tsName "status" ;
    cp:value 1381015553 ;
    rdfs:label "statusCode, default OK (0x5250A001); out-of-band decodes fail-closed" .

cp:f_flags a cp:FrameField ;
    cp:fieldOf cp:hdr ;
    cp:offset 10 ; cp:sizeBytes 2 ; cp:nextOffset 12 ;
    cp:wireKind cp:wkU16LE ;
    cp:cName "flags" ; cp:rustName "flags" ; cp:tsName "flags" ;
    cp:value 0 ;
    rdfs:label "reserved, zero-on-write, ignored-but-pinned on read" .

cp:f_seq a cp:FrameField ;
    cp:fieldOf cp:hdr ;
    cp:offset 12 ; cp:sizeBytes 4 ; cp:nextOffset 16 ;
    cp:wireKind cp:wkU32LE ;
    cp:cName "frame_seq" ; cp:rustName "frame_seq" ; cp:tsName "frameSeq" ;
    cp:value 0 ;
    rdfs:label "monotonic per-issuer sequence (mod 2^32)" .

cp:f_binding a cp:FrameField ;
    cp:fieldOf cp:hdr ;
    cp:offset 16 ; cp:sizeBytes 32 ; cp:nextOffset 48 ;
    cp:wireKind cp:wkBytes32 ;
    cp:cName "binding" ; cp:rustName "binding" ; cp:tsName "binding" ;
    rdfs:label "32B keyed-BLAKE3 binding of the 229B UnsealedReceipt" .

cp:f_root a cp:FrameField ;
    cp:fieldOf cp:hdr ;
    cp:offset 48 ; cp:sizeBytes 8 ; cp:nextOffset 56 ;
    cp:wireKind cp:wkBytes8 ;
    cp:cName "root_prefix" ; cp:rustName "root_prefix" ; cp:tsName "rootPrefix" ;
    rdfs:label "8B admissions Merkle root prefix" .

cp:f_payloadLen a cp:FrameField ;
    cp:fieldOf cp:hdr ;
    cp:offset 56 ; cp:sizeBytes 4 ; cp:nextOffset 60 ;
    cp:wireKind cp:wkU32LE ;
    cp:cName "payload_len" ; cp:rustName "payload_len" ; cp:tsName "payloadLen" ;
    cp:value 0 ;
    rdfs:label "reserved for future variable-length annex; zero now" .

cp:f_digest a cp:FrameField ;
    cp:fieldOf cp:hdr ;
    cp:offset 60 ; cp:sizeBytes 4 ; cp:nextOffset 64 ;
    cp:wireKind cp:wkU32LE ;
    cp:cName "fnv1a32" ; cp:rustName "fnv1a32" ; cp:tsName "fnv1a32" ;
    cp:value 2166136261 ;
    rdfs:label "FNV-1a32 digest over bytes [0x00,0x3C); offset basis 2166136261, prime 16777619" .

cp:cMagic a cp:StatusConstant ;
    cp:constantId "MAGIC" ;
    cp:value 1380986929 ;
    cp:docBand "0x52503031" .
cp:cVersion a cp:StatusConstant ;
    cp:constantId "VERSION" ;
    cp:value 1 ;
    cp:docBand "layout version, starts at 1" .
cp:algBlake3 a cp:StatusConstant ;
    cp:constantId "ALG_ID_KEYED_BLAKE3" ;
    cp:value 0 ;
    cp:docBand "229B UnsealedReceipt tier (client)" .
cp:algMlDsa a cp:StatusConstant ;
    cp:constantId "ALG_ID_ML_DSA_65" ;
    cp:value 1 ;
    cp:docBand "3309B sealed tier (server trust boundary)" .

# Seam notes
cp:snAlgId a cp:SeamNote ;
    cp:seam "algId upgrade seam: client emits keyed-BLAKE3 (0x0000); ML-DSA-65 seal (0x0001) applies at server trust boundary" .
cp:snDeterminism a cp:SeamNote ;
    cp:seam "determinism law: generated code wins over hand-written; no wall-clock stamping" .
cp:snZeroJson a cp:SeamNote ;
    cp:seam "zero-JSON across worker boundary and kernel ABI; binary fixed-width only" .
cp:snHeaderGrounding a cp:SeamNote ;
    cp:seam "header grounding: 64B frame; FNV-1a32 (basis 2166136261, prime 16777619) over bytes [0x00,0x3C), digest at offset 0x3C" .

# Hyperplane invariants (demo values: NTE 800, GPM 0.22, geofence 200m)
cp:hypDemo a cp:Hyperplane ; cp:planeDim 3 ; cp:planeNormal cp:hypDemo ;
    rdfs:label "demo hyperplane: 3 dims; bounds carried by NodeShapes below" .

# SHACL entity contracts (single contract; hand-written zod banned)
cp:WorkOrderShape a sh:NodeShape ;
    sh:targetClass cp:WorkOrder ;
    sh:closed true ;
    sh:property
        [ sh:path cp:orderId ;   sh:datatype xsd:string ;  sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path cp:nteLimit ;  sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:minInclusive 1 ; sh:maxInclusive 800 ] ,
        [ sh:path cp:gpmLimit ;  sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:minInclusive 0.22 ] ,
        [ sh:path cp:tier ;      sh:datatype xsd:string ;  sh:minCount 1 ; sh:maxCount 1 ;
          sh:in ( "Client" "Boundary" "Server" ) ] .

cp:NteRecordShape a sh:NodeShape ;
    sh:targetClass cp:NteRecord ;
    sh:closed true ;
    sh:property
        [ sh:path cp:nteValue ;   sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:minInclusive 1 ; sh:maxInclusive 800 ] ,
        [ sh:path cp:observedAt ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] .

cp:GpmReadingShape a sh:NodeShape ;
    sh:targetClass cp:GpmReading ;
    sh:closed true ;
    sh:property
        [ sh:path cp:gpmValue ;   sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:minInclusive 0.0 ] ,
        [ sh:path cp:breachFlag ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ] .

cp:GeofenceRegionShape a sh:NodeShape ;
    sh:targetClass cp:GeofenceRegion ;
    sh:closed true ;
    sh:property
        [ sh:path cp:radiusMeters ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:minInclusive 0 ; sh:maxInclusive 200 ] ,
        [ sh:path cp:regionId ;    sh:datatype xsd:string ;  sh:minCount 1 ; sh:maxCount 1 ] .
# docs/targets.ttl — doc-generation target facts (lane G5 authored).
# These describe ONLY the docs/ projection pipeline in this directory; the
# ABI code targets live in ../targets.toml and are documented by reference.
@prefix cp: <urn:cgap-popcorn-aoq:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

cp:DocTarget a owl:Class ;
    rdfs:label "a docs/ surface generated by one ggen rule" .

cp:dtWireLaw a cp:DocTarget ;
    cp:docName "wire_law.md" ;
    cp:emittingTemplate "templates/wire_law.md.tera" ;
    cp:sourceQuery "queries/wire_law.rq" ;
    cp:freezePolicy "Overwrite: generated wins over hand-written; never hand-patch the output — edit ontology.ttl/targets.ttl and re-run ggen sync run" ;
    cp:rowsSource "FrameField (fieldOf cp:hdr) + StatusConstant + SeamNote individuals" .

cp:dtHookRegistry a cp:DocTarget ;
    cp:docName "hook_registry.md" ;
    cp:emittingTemplate "templates/hook_registry.md.tera" ;
    cp:sourceQuery "queries/hook_registry.rq" ;
    cp:freezePolicy "Overwrite: generated wins over hand-written; never hand-patch the output — edit ontology.ttl and re-run ggen sync run" ;
    cp:rowsSource "HookName + ActorMessageKind owl:oneOf members" .

cp:dtTargets a cp:DocTarget ;
    cp:docName "targets.md" ;
    cp:emittingTemplate "templates/targets.md.tera" ;
    cp:sourceQuery "queries/targets.rq" ;
    cp:freezePolicy "Overwrite: generated wins over hand-written; never hand-patch the output — edit docs/targets.ttl and re-run ggen sync run" ;
    cp:rowsSource "cp:DocTarget individuals in docs/targets.ttl" .
