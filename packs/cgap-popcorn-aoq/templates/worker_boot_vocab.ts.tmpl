---
to: packages/worker/src/boot/generatedVocab.ts
force: true
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/cgap-popcorn-aoq
# Same subject-IRI contract as abi_kernel.rs.tmpl. UNVERIFIED-vs-C16.
sparql:
  subject: >
    PREFIX cp: <urn:cgap-popcorn-aoq:>
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?pascal ?snake WHERE {
      cp:subject a gc:GenerationSubject ;
                 gc:pascal ?pascal ;
                 gc:snake ?snake .
    }
  frameTypes: >
    PREFIX cp: <urn:cgap-popcorn-aoq:>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?v ?label WHERE {
      ?m a cp:FrameType ; cp:value ?v .
      OPTIONAL { ?m rdfs:label ?label }
    } ORDER BY ?v
  agentTier: >
    PREFIX cp: <urn:cgap-popcorn-aoq:>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?v ?label WHERE {
      ?m a cp:AgentTier ; cp:value ?v .
      OPTIONAL { ?m rdfs:label ?label }
    } ORDER BY ?v
  consts: >
    PREFIX cp: <urn:cgap-popcorn-aoq:>
    SELECT ?cid ?v ?doc WHERE {
      ?c a cp:StatusConstant ;
         cp:value ?v ;
         cp:docBand ?doc .
      BIND(UCASE(REPLACE(REPLACE(STR(?c), "^.+:", ""), "([a-z0-9])([A-Z])", "$1_$2")) AS ?cid)
    } ORDER BY ?cid
