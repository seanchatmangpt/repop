---
to: kernel/crates/repop-abi/src/generated_layout.rs
force: true
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/cgap-popcorn-aoq
# SUBJECT-IRI CONTRACT — fix for the ai-chatbot-shadcn-pack IRI-mismatch bug:
# the ontology mints exactly ONE GenerationSubject individual,
#   cp:subject a gc:GenerationSubject   (cp: = urn:cgap-popcorn-aoq:)
# and every template in this pack queries that exact IRI, identical prefix,
# casing, local name, so minted and matched IRIs cannot diverge. An empty
# subject binding means not-yet-minted: templates render a deterministic
# UNBOUND fallback and the pack gate fails closed. UNVERIFIED-vs-C16.
sparql:
  fields: >
    PREFIX cp: <urn:cgap-popcorn-aoq:>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?frame ?fName ?fOffset ?fWidth ?fNext ?fKindName WHERE {
      ?row a cp:FrameField ;
           cp:fieldOf ?frame ;
           cp:rustName ?fName ;
           cp:offset ?fOffset ;
           cp:sizeBytes ?fWidth ;
           cp:nextOffset ?fNext ;
           cp:wireKind ?wk .
      BIND(REPLACE(STR(?wk), "^.+:wk", "") AS ?fKindName)
    } ORDER BY ?frame ?fOffset
  consts: >
    PREFIX cp: <urn:cgap-popcorn-aoq:>
    SELECT ?cid ?v ?doc WHERE {
      ?c a cp:StatusConstant ;
         cp:value ?v ;
         cp:docBand ?doc .
      BIND(UCASE(REPLACE(REPLACE(STR(?c), "^.+:", ""), "([a-z0-9])([A-Z])", "$1_$2")) AS ?cid)
    } ORDER BY ?cid
  enums: >
    PREFIX cp: <urn:cgap-popcorn-aoq:>
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?enumName ?v ?label WHERE {
      ?enum a owl:Class ;
            owl:oneOf ?list .
      ?list rdf:rest*/rdf:first ?m .
      ?m cp:value ?v .
      BIND(REPLACE(STR(?enum), "^.+:", "") AS ?enumName)
      OPTIONAL { ?m rdfs:label ?label }
    } ORDER BY ?enumName ?v
  subject: >
    PREFIX cp: <urn:cgap-popcorn-aoq:>
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?pascal ?snake WHERE {
      cp:subject a gc:GenerationSubject ;
                 gc:pascal ?pascal ;
                 gc:snake ?snake .
    }
---

{% raw %}
// Code generated by ggen from packs/cgap-popcorn-aoq/ontology.ttl. DO NOT EDIT.
//
//! Generated layout for the three pinned 64B frames (IntentFrame 0x4946 /
//! HyperplaneRegister 0x4850 / ReceiptFrame 0x5246), projected row-for-row
//! from the ontology FrameField tables (cp:fieldOf cp:frameIntent |
//! cp:frameHyperplane | cp:frameReceipt). Namespaced under `pub mod
//! generated` so the P1 freeze cutover can wire `mod generated_layout;`
//! into the repop-abi crate root without colliding with hand-written
//! layout_spec.rs; generated wins at that cutover.
//!
//! Determinism: no wall-clock stamping; byte-identical renders are gate-09.
{% endraw %}
//! Subject binding: {{ subject[0].pascal if subject else "UNBOUND-SUBJECT" }}
{% raw %}
//! (cp:subject a gc:GenerationSubject not yet minted; gate fails closed.)
{% endraw %}

pub mod generated {
{%- for group in fields | groupby('frame') %}
{%- set fname = group.grouper.split(':')[-1] %}
{%- set ident = {"frameIntent": "INTENT", "frameHyperplane": "HYPERPLANE", "frameReceipt": "RECEIPT"}[fname] %}
{%- set struct = {"frameIntent": "IntentFrame", "frameHyperplane": "HyperplaneRegister", "frameReceipt": "ReceiptFrame"}[fname] %}

    /// {{ struct }} field table, ordered by ontology cp:offset.
    pub const {{ ident }}_FIELDS: [FrameFieldRow; {{ group.list | length }}] = [
    {%- for f in group.list %}
        FrameFieldRow {
            offset: {{ f.fOffset }},
            width: {{ f.fWidth }},
            next_offset: {{ f.fNext }},
            name: "{{ f.fName }}",
            kind: {% if f.fKindName == "U16LE" %}FrameWireKind::U16{% elif f.fKindName == "U32LE" %}FrameWireKind::U32{% elif f.fKindName == "U64LE" %}FrameWireKind::U64{% elif f.fKindName == "F64LE" %}FrameWireKind::F64{% elif f.fKindName == "Bytes8" %}FrameWireKind::Bytes8{% elif f.fKindName == "Bytes16" %}FrameWireKind::Bytes16{% elif f.fKindName == "Bytes32" %}FrameWireKind::Bytes32{% else %}UNMAPPED_WIRE_KIND("{{ f.fKindName }}"){% endif %},
        },
    {%- endfor %}
    ];

    /// Contiguity court for {{ struct }}: each row lands at its ontology
    /// offset and ends exactly where the next row begins.
    const _: () = {
        let table = {{ ident }}_FIELDS;
    {%- for f in group.list %}
        assert!(table[{{ loop.index0 }}].offset == {{ f.fOffset }});
        assert!(table[{{ loop.index0 }}].next_offset
            == {{ f.fNext }});
    {%- endfor %}
        assert!(table[table.len() - 1].next_offset <= FRAME_SIZE);
    };
{%- endfor %}

    /// One field-table row (mirror of an ontology cp:FrameField).
    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    pub struct FrameFieldRow {
        pub offset: usize,
        pub width: usize,
        pub next_offset: usize,
        pub name: &'static str,
        pub kind: FrameWireKind,
    }

    /// Closed wire primitive kinds (projected from cp:WireKind members).
    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    pub enum FrameWireKind {
        U16,
        U32,
        U64,
        F64,
        Bytes8,
        Bytes16,
        Bytes32,
    }

    /// Named constants, projected from cp:StatusConstant rows.
{%- for c in consts %}
    /// {{ c.doc }}
    pub const {{ c.cid }}: u32 = {{ c.v }};
{%- endfor %}
}
