---
to: packages/abi/src/generated/layout.ts
force: true
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/cgap-popcorn-aoq
# SUBJECT-IRI CONTRACT — identical to abi_kernel.rs.tmpl: one GenerationSubject
# individual (cp:subject a gc:GenerationSubject), queried with the same
# prefix/casing/local-name in every template; empty binding = deterministic
# UNBOUND fallback, pack gate fails closed. UNVERIFIED-vs-C16.
sparql:
  fields: >
    PREFIX cp: <urn:cgap-popcorn-aoq:>
    SELECT ?frame ?fName ?fOffset ?fWidth ?fNext ?fKindName WHERE {
      ?row a cp:FrameField ;
           cp:fieldOf ?frame ;
           cp:tsName ?fName ;
           cp:offset ?fOffset ;
           cp:sizeBytes ?fWidth ;
           cp:nextOffset ?fNext ;
           cp:wireKind ?wk .
      BIND(REPLACE(STR(?wk), "^.+:wk", "") AS ?fKindName)
    } ORDER BY ?frame ?fOffset
  consts: >
    PREFIX cp: <urn:cgap-popcorn-aoq:>
    SELECT ?cid ?v ?doc WHERE {
      ?c a cp:StatusConstant ;
         cp:value ?v ;
         cp:docBand ?doc .
      BIND(UCASE(REPLACE(REPLACE(STR(?c), "^.+:", ""), "([a-z0-9])([A-Z])", "$1_$2")) AS ?cid)
    } ORDER BY ?cid
  subject: >
    PREFIX cp: <urn:cgap-popcorn-aoq:>
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?pascal ?snake WHERE {
      cp:subject a gc:GenerationSubject ;
                 gc:pascal ?pascal ;
                 gc:snake ?snake .
    }
---

{% raw %}
/**
 * Code generated by ggen from packs/cgap-popcorn-aoq/ontology.ttl. DO NOT EDIT.
 *
 * Generated TS mirror of the three pinned 64B frame layouts (IntentFrame
 * 0x4946 / HyperplaneRegister 0x4850 / ReceiptFrame 0x5246), projected
 * row-for-row from the ontology FrameField tables (cp:tsName surface).
 * Namespaced GENERATED_/FRAME_/GENERATED_FRAME_ so the freeze cutover can
 * replace the hand-maintained mirror without colliding with its exports;
 * generated wins at cutover. No wall-clock stamping (gate-09-determinism).
 *
{% endraw %}
 * Subject binding: {{ subject[0].pascal if subject else "UNBOUND-SUBJECT" }}
{% raw %}
 */
{% endraw %}

export const GENERATED_FRAME_SIZE = 64;
export const GENERATED_DIGEST_SPAN = 60;
export const GENERATED_DIGEST_OFFSET = 60;

{% raw %}
/** Wire primitive kinds, closed set from cp:WireKind. */
export type GeneratedWireKind =
  | "U16LE"
  | "U32LE"
  | "U64LE"
  | "F64LE"
  | "Bytes8"
  | "Bytes16"
  | "Bytes32";

/** One field-table row (mirror of an ontology cp:FrameField). */
export interface GeneratedFieldRow {
  readonly frame: string;
  readonly offset: number;
  readonly width: number;
  readonly nextOffset: number;
  readonly name: string;
  readonly kind: GeneratedWireKind;
}
{% endraw %}

{% raw %}export const GENERATED_FRAME_FIELDS: readonly GeneratedFieldRow[] = [
{% endraw %}
{%- for f in fields %}
{% raw %}  {% endraw %}{ frame: "{{ f.frame.split(':')[-1] }}", offset: {{ f.fOffset }}, width: {{ f.fWidth }}, nextOffset: {{ f.fNext }}, name: "{{ f.fName }}", kind: "{{ f.fKindName }}" },
{%- endfor %}
{% raw %}
] as const;

/** Contiguity gate: fail-closed on any gap, overlap, or digest overflow. */
for (let i = 0; i < GENERATED_FRAME_FIELDS.length; i++) {
  const row = GENERATED_FRAME_FIELDS[i]!;
  if (row.offset + row.width !== row.nextOffset) {
    throw new Error(`field gap at ${row.frame}.${row.name}`);
  }
  const prev = GENERATED_FRAME_FIELDS[i - 1];
  if (prev && prev.frame === row.frame && prev.nextOffset !== row.offset) {
    throw new Error(`field discontinuity after ${prev.frame}.${prev.name}`);
  }
}
{% endraw %}

/** Named wire constants, projected from cp:StatusConstant. */
export const GENERATED_CONSTANTS = {
{%- for c in consts %}
  /** {{ c.doc }} */
  {{ c.cid }}: {{ c.v }},
{%- endfor %}
} as const;
