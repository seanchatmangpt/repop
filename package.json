{
  "name": "repop",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "npx vitest run --project unit --passWithNoTests",
    "test:browser": "npx vitest run --project browser",
    "test:smoke": "pnpm exec playwright test --config playwright.smoke.config.ts",
    "verify": "bash scripts/verify.sh",
    "verify-aggregate": "pnpm run verify && cd kernel && just courts && just footprint"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@vitest/browser": "^3.2.7",
    "jsdom": "^27.4.0",
    "playwright": "^1.55.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
